#include <windows.h>
#include "../common/plugin_resources.h"
#include "../common/plugin_version.h"
#pragma code_page(65001)

// Common Controls 6 manifest, activated only while the settings dialog is open.
3 RT_MANIFEST "utility-pack.manifest"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
    TC_PLUGIN_HEADER_ID "tclock.plugin/1:utility.pack"
    TC_PLUGIN_NAME_ID "UtilityPack"
    TC_PLUGIN_DESCRIPTION_ID "Adds builtin operations that open Windows tools, settings pages and folders, and run administrator commands. Choose the items in Settings."
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    TC_PLUGIN_NAME_ID "ユーティリティパック"
    TC_PLUGIN_DESCRIPTION_ID "Windowsのツール・設定画面・フォルダーを開く操作や、管理者コマンドをビルトイン操作に追加します。追加する項目は「設定」で選べます。"
END

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 VERSIONINFO
FILEVERSION TC_VERSION_VALUE(UTILITY_PACK_VERSION)
PRODUCTVERSION TC_VERSION_VALUE(UTILITY_PACK_VERSION)
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "UtilityPack plugin"
            VALUE "FileVersion", TC_VERSION_TEXT(UTILITY_PACK_VERSION)
            VALUE "ProductVersion", TC_VERSION_TEXT(UTILITY_PACK_VERSION)
            VALUE "ProductName", "UtilityPack"
            VALUE "InternalName", "UtilityPack"
            VALUE "OriginalFilename", "UtilityPack.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
