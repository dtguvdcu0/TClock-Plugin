#include <windows.h>
#include "resource.h"
#include "../common/plugin_resources.h"
#pragma code_page(65001)
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
    TC_PLUGIN_HEADER_ID "tclock.plugin/1:color.settings2"
    TC_PLUGIN_NAME_ID "Color Settings 2"
    TC_PLUGIN_SETTINGS_HINT_ID "none"
    TC_PLUGIN_DESCRIPTION_ID "Adds an embedded Colors 2 property page and text color policy."
END
LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    TC_PLUGIN_NAME_ID "色設定2"
    TC_PLUGIN_DESCRIPTION_ID "土曜・日曜・祝日・VPN接続中の文字色を設定します。プロパティの「色設定2」で変更できます。"
END
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
101 DIALOGEX 0, 0, 210, 230
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "MS UI Gothic", 0, 0, 0x0
BEGIN
    CONTROL         "日付",IDC_CHKCOL_DATE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,99,37,11
    PUSHBUTTON      "...",IDC_CHOOSECOL_SAT,154,24,12,13
    CONTROL         "曜日",IDC_CHKCOL_DOW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,46,99,37,11
    COMBOBOX        IDC_COL_SUN,73,46,76,120,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_CHOOSECOL_SUN,154,46,12,13
    CONTROL         "VPN接続時に文字色を変更する",IDC_CHKCOL_VPN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,142,135,11
    COMBOBOX        IDC_COL_VPN,73,157,76,120,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_CHOOSECOL_VPN,154,157,12,13
    CONTROL         "時刻",IDC_CHKCOL_TIME,"Button",BS_AUTOCHECKBOX | BS_LEFT | WS_TABSTOP,86,99,37,11
    CONTROL         "すべての文字",IDC_CHKCOL_ALL,"Button",BS_AUTOCHECKBOX | BS_LEFT | WS_TABSTOP,138,99,57,11
    LTEXT           "土曜日",IDC_STATIC,29,27,23,8
    LTEXT           "日曜日",IDC_STATIC,29,47,23,8
    COMBOBOX        IDC_COL_HOLIDAY,73,65,76,120,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_CHOOSECOL_HOLIDAY,154,65,12,13
    LTEXT           "祝日",IDC_STATIC,29,65,16,8
    LTEXT           "曜日別文字色の設定",IDC_STATIC,8,10,66,8
    LTEXT           "曜日別文字色の適用対象",IDC_STATIC,9,86,81,8
    LTEXT           "※""その他""設定でVPNキーワードを登録してください。",IDC_STATIC,29,175,156,8
    COMBOBOX        IDC_COL_SAT,73,24,76,120,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
END

102 DIALOGEX 0, 0, 210, 230
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "MS UI Gothic", 0, 0, 0x0
BEGIN
    CONTROL         "Data",IDC_CHKCOL_DATE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,99,37,11
    COMBOBOX        IDC_COL_SAT,74,26,76,120,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_CHOOSECOL_SAT,155,26,12,13
    CONTROL         "Day of week",IDC_CHKCOL_DOW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,48,99,51,11
    COMBOBOX        IDC_COL_SUN,74,46,76,120,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_CHOOSECOL_SUN,155,46,12,13
    CONTROL         "Change color during VPN connection",IDC_CHKCOL_VPN,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,142,135,11
    COMBOBOX        IDC_COL_VPN,73,157,76,120,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_CHOOSECOL_VPN,154,157,12,13
    CONTROL         "Time",IDC_CHKCOL_TIME,"Button",BS_AUTOCHECKBOX | BS_LEFT | WS_TABSTOP,107,99,37,11
    CONTROL         "All",IDC_CHKCOL_ALL,"Button",BS_AUTOCHECKBOX | BS_LEFT | WS_TABSTOP,147,99,57,11
    LTEXT           "Saturday",IDC_STATIC,29,26,28,8
    LTEXT           "Sunday",IDC_STATIC,29,46,23,8
    LTEXT           "*Holiday is available only in Japanese mode.",IDC_STATIC,29,66,135,8
    LTEXT           "Text colors for weekend",IDC_STATIC,11,10,75,8
    LTEXT           "Applied to:",IDC_STATIC,10,86,33,8
    LTEXT           "※Set VPN keywords in ""Additional Setting""",IDC_STATIC,14,174,136,8
END
