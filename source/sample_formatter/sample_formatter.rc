/*
 * プラグイン一覧に表示する名前と説明文、DLLの検出に使う情報を定義します。
 * 日本語を扱えるよう、このファイルはUTF-8で保存します。
 */
#pragma code_page(65001)
#include <windows.h>
#include "../common/plugin_resources.h"
#include "../common/plugin_version.h"

/* 設定画面の説明欄に表示する文章です。英語と日本語を用意します。 */
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    TC_PLUGIN_DESCRIPTION_ID "Formats the clock and tooltip text. Replaces ${time}, ${date}, ${cpu}, ${mem} and ${battery} in the format; CPU usage of 80% or more is shown in red."
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    TC_PLUGIN_DESCRIPTION_ID "時計とツールチップの文字列を作ります。書式中の ${time}、${date}、${cpu}、${mem}、${battery} を値に置き換え、CPU使用率が80%以上のときは赤色で表示します。"
END

/* 検出用のIDと一覧の名前は、表示言語によらず共通にします。 */
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
    /* コロンの後のIDを、C側の sf_info と揃えます。 */
    TC_PLUGIN_HEADER_ID "tclock.plugin/1:sample.formatter"

    /* プラグイン一覧に表示する名前です。 */
    TC_PLUGIN_NAME_ID "SampleFormatter"

    /* 個別設定がないことを本体に伝え、設定ボタンを無効にします。 */
    TC_PLUGIN_SETTINGS_HINT_ID "none"
END

#define SAMPLE_VERSION TC_VERSION_VALUE(SAMPLE_FORMATTER_VERSION)
#define SAMPLE_VERSION_TEXT TC_VERSION_TEXT(SAMPLE_FORMATTER_VERSION)

1 VERSIONINFO
 FILEVERSION SAMPLE_VERSION
 PRODUCTVERSION SAMPLE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "SampleFormatter plugin\0"
            VALUE "FileVersion", SAMPLE_VERSION_TEXT
            VALUE "InternalName", "SampleFormatter\0"
            VALUE "OriginalFilename", "SampleFormatter.dll\0"
            VALUE "ProductName", "SampleFormatter\0"
            VALUE "ProductVersion", SAMPLE_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
