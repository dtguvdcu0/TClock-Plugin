#include <windows.h>
#include "../../common/plugin_version.h"

1 ICON "../icon3.ico"

1 VERSIONINFO
FILEVERSION TC_VERSION_VALUE(TCARD_VERSION)
PRODUCTVERSION TC_VERSION_VALUE(TCARD_VERSION)
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileVersion", TC_VERSION_TEXT(TCARD_VERSION)
            VALUE "ProductVersion", TC_VERSION_TEXT(TCARD_VERSION)
            VALUE "ProductName", "TCard"
            VALUE "InternalName", "TCard"
            VALUE "OriginalFilename", "TCard.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
